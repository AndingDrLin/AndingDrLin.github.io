---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { NOTE_COURSES } from '../consts';
import { formatDate } from '../utils/content';

interface Props {
  entry: CollectionEntry<'blog'> | CollectionEntry<'notes'> | CollectionEntry<'docs'>;
  showKind?: boolean;
}

const { entry, showKind = false } = Astro.props;
const course = entry.collection === 'docs' ? NOTE_COURSES[entry.data.docGroup as keyof typeof NOTE_COURSES] : undefined;
const noteSlug = course ? entry.id.replace(/^[^/]+\//, '').replace(/\/readme$/i, '') : entry.id;
const href = course
  ? `/notes/${course.slug}/${noteSlug}/`
  : `/${entry.collection}/${entry.id}/`;
const kindLabels = {
  blog: '博客',
  notes: '笔记',
  docs: '课程笔记'
};
const kindLabel = kindLabels[entry.collection];
---

<article class="post-card">
  <div class="post-card-meta">
    <span>{formatDate(entry.data.date)}</span>
    <span>·</span>
    <span>{entry.data.category}</span>
    {showKind && (
      <>
        <span>·</span>
        <span>{kindLabel}</span>
      </>
    )}
  </div>
  <h2 class="post-card-title">
    <a href={href}>{entry.data.title}</a>
  </h2>
  <p class="post-card-description">{entry.data.description}</p>
  <TagList tags={entry.data.tags} />
</article>
