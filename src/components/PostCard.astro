---
import type { CollectionEntry } from 'astro:content';
import { NOTE_COURSES, NOTE_TUTORIALS, ARTICLE_META } from '../consts';
import { formatDate } from '../utils/content';
import { isReadmeEntry, getNoteUrl } from '../utils/noteTree';

interface Props {
  entry: CollectionEntry<'blog'> | CollectionEntry<'notes'>;
  showKind?: boolean;
}

const { entry, showKind = false } = Astro.props;
const course = entry.collection === 'notes' ? NOTE_COURSES[entry.data.docGroup as keyof typeof NOTE_COURSES] : undefined;
const tutorial = entry.collection === 'notes' ? NOTE_TUTORIALS[entry.data.docGroup as keyof typeof NOTE_TUTORIALS] : undefined;
const isCourseReadme = course && isReadmeEntry(entry);
const isTutorialReadme = tutorial && isReadmeEntry(entry);
const href = isCourseReadme
  ? `/notes/${course.slug}/`
  : isTutorialReadme
    ? `/notes/tutorial/${tutorial.slug}/`
    : entry.collection === 'notes'
      ? getNoteUrl(entry)
      : `/${entry.collection}/${entry.id}/`;
const kindLabel = ARTICLE_META.kindLabels[entry.collection];
---

<article class="post-card">
  <div class="post-card-meta">
    <span>{formatDate(entry.data.date)}</span>
    <span>·</span>
    <span>{entry.data.category}</span>
    {showKind && (
      <>
        <span>·</span>
        <span>{kindLabel}</span>
      </>
    )}
  </div>
  <h2 class="post-card-title">
    <a href={href}>{entry.data.title}</a>
  </h2>
  <p class="post-card-description">{entry.data.description}</p>
</article>
