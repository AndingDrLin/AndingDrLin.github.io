---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { formatDate } from '../utils/content';

interface Props {
  entry: CollectionEntry<'blog'> | CollectionEntry<'notes'> | CollectionEntry<'docs'>;
  showKind?: boolean;
}

const { entry, showKind = false } = Astro.props;
const href = /\/readme$/i.test(entry.id)
  ? `/${entry.collection}/${entry.id.replace(/\/readme$/i, '')}/`
  : `/${entry.collection}/${entry.id}/`;
const kindLabels = {
  blog: '博客',
  notes: '笔记',
  docs: '文档'
};
const kindLabel = kindLabels[entry.collection];
---

<article class="post-card">
  <div class="post-card-meta">
    <span>{formatDate(entry.data.date)}</span>
    <span>·</span>
    <span>{entry.data.category}</span>
    {showKind && (
      <>
        <span>·</span>
        <span>{kindLabel}</span>
      </>
    )}
  </div>
  <h2 class="post-card-title">
    <a href={href}>{entry.data.title}</a>
  </h2>
  <p class="post-card-description">{entry.data.description}</p>
  <TagList tags={entry.data.tags} />
</article>
