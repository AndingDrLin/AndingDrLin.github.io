---
import { SEARCH } from '../consts';
---

<div class="search-container">
  <button class="search-trigger" aria-label={SEARCH.triggerLabel} data-search-trigger>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <span>{SEARCH.triggerLabel}</span>
    <kbd data-shortcut-hint>⌘K</kbd>
  </button>

  <dialog class="search-dialog" data-search-dialog aria-label={SEARCH.triggerLabel}>
    <div class="search-dialog-inner">
      <div class="search-input-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="text"
          class="search-input"
          placeholder={SEARCH.placeholder}
          data-search-input
          aria-label={SEARCH.triggerLabel}
        />
        <kbd class="search-close-hint">ESC</kbd>
      </div>
      <div
        class="search-results"
        data-search-results
        data-no-results={SEARCH.noResults}
        data-dev-mode-hint={SEARCH.devModeHint}
        data-untitled={SEARCH.untitled}
        data-suggestions={SEARCH.suggestions.join('|')}
        aria-live="polite"
      ></div>
    </div>
  </dialog>
</div>

<script is:inline>
  /* ── cross-platform shortcut hint ── */
  (function() {
    const hint = document.querySelector('[data-shortcut-hint]');
    if (!hint) return;
    const isMac = /^Mac/.test(navigator.platform || '');
    if (!isMac) hint.textContent = 'Ctrl+K';
  })();

  let pagefind;

  async function initPagefind() {
    if (!pagefind) {
      pagefind = await import('/pagefind/pagefind.js');
      pagefind.init();
    }
    return pagefind;
  }

  const dialog = document.querySelector('[data-search-dialog]');
  const trigger = document.querySelector('[data-search-trigger]');
  const input = document.querySelector('[data-search-input]');
  const resultsContainer = document.querySelector('[data-search-results]');
  const searchCopy = {
    noResults: resultsContainer?.dataset.noResults ?? '没有找到相关内容',
    devModeHint: resultsContainer?.dataset.devModeHint ?? '搜索仅在构建后可用',
    untitled: resultsContainer?.dataset.untitled ?? '无标题',
    suggestions: resultsContainer?.dataset.suggestions?.split('|') ?? []
  };

  function getActiveIndex() {
    const items = resultsContainer?.querySelectorAll('.search-result');
    if (!items) return -1;
    for (let i = 0; i < items.length; i++) {
      if (items[i].classList.contains('search-result--active')) return i;
    }
    return -1;
  }

  function setActive(index) {
    const items = resultsContainer?.querySelectorAll('.search-result');
    if (!items) return;
    items.forEach(function(el) { el.classList.remove('search-result--active'); });
    if (index >= 0 && index < items.length) {
      items[index].classList.add('search-result--active');
      items[index].scrollIntoView({ block: 'nearest' });
    }
  }

  function renderSuggestions() {
    if (!resultsContainer) return;

    resultsContainer.innerHTML = `
      <div class="search-empty">
        <p>可以试试这些关键词：</p>
        <div class="search-suggestions">
          ${searchCopy.suggestions.map((item) => `<button type="button" data-search-suggestion="${item}">${item}</button>`).join('')}
        </div>
      </div>
    `;
  }

  function openSearch() {
    if (dialog instanceof HTMLDialogElement) {
      dialog.showModal();
      renderSuggestions();
      if (input instanceof HTMLInputElement) input.focus();
    }
  }

  function closeSearch() {
    if (dialog instanceof HTMLDialogElement) {
      dialog.close();
      if (input instanceof HTMLInputElement) input.value = '';
      if (resultsContainer) resultsContainer.innerHTML = '';
    }
  }

  trigger?.addEventListener('click', openSearch);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape') closeSearch();
  });

  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const items = resultsContainer?.querySelectorAll('.search-result');
      if (!items || items.length === 0) return;
      const idx = getActiveIndex();
      setActive(idx < items.length - 1 ? idx + 1 : 0);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const items = resultsContainer?.querySelectorAll('.search-result');
      if (!items || items.length === 0) return;
      const idx = getActiveIndex();
      setActive(idx > 0 ? idx - 1 : items.length - 1);
    } else if (e.key === 'Enter') {
      const items = resultsContainer?.querySelectorAll('.search-result');
      if (!items) return;
      const idx = getActiveIndex();
      if (idx >= 0 && idx < items.length) {
        e.preventDefault();
        const href = items[idx].getAttribute('href');
        if (href) window.location.href = href;
      }
    }
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) closeSearch();
  });

  let searchTimeout;
  resultsContainer?.addEventListener('click', (e) => {
    const target = e.target;
    if (!(target instanceof HTMLButtonElement) || !(input instanceof HTMLInputElement)) return;

    const suggestion = target.dataset.searchSuggestion;
    if (!suggestion) return;

    input.value = suggestion;
    input.dispatchEvent(new Event('input'));
  });

  input?.addEventListener('input', async (e) => {
    const query = e.target.value;

    clearTimeout(searchTimeout);

    if (query.length < 2) {
      renderSuggestions();
      return;
    }

    // Show loading indicator
    if (resultsContainer) {
      resultsContainer.innerHTML = '<div class="search-loading"><div class="search-spinner"></div><span>搜索中...</span></div>';
    }

    searchTimeout = setTimeout(async () => {
      try {
        const pf = await initPagefind();
        const search = await pf.debouncedSearch(query);

        if (!search || !search.results || search.results.length === 0) {
          if (resultsContainer) resultsContainer.innerHTML = `<p class="search-empty">${searchCopy.noResults}</p>`;
          return;
        }

        const results = await Promise.all(
          search.results.slice(0, 10).map(async (result) => await result.data())
        );

        if (resultsContainer) {
          resultsContainer.innerHTML = results
            .map(
              (result) => `
              <a href="${result.url}" class="search-result">
                <div class="search-result-title">${result.meta?.title || searchCopy.untitled}</div>
                <div class="search-result-excerpt">${result.excerpt}</div>
              </a>
            `
            )
            .join('');
        }
      } catch {
        if (resultsContainer) resultsContainer.innerHTML = `<p class="search-empty">${searchCopy.devModeHint}</p>`;
      }
    }, 300);
  });
</script>
