---
import { slugifyTag } from '../utils/tags';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tag-list" aria-label="标签">
    {tags.map((tag) => (
      <li>
        <a href={`/tags/${slugifyTag(tag)}/`}>#{tag}</a>
      </li>
    ))}
  </ul>
)}
