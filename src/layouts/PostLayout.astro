---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import { ARTICLE_META } from '../consts';
import { formatDate } from '../utils/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  category: string;
  readingTime: string;
  headings: Heading[];
  path: string;
  kind: string;
  source?: string;
  tags?: string[];
}

const { title, description, date, updated, category, readingTime, headings, path, kind, source, tags } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={updated?.toISOString()}
  tags={tags}
>
  <article class="article-layout">
    <TOC headings={headings} />
    <div class="article-main">
      <header class="article-header">
        <p class="eyebrow">{kind}</p>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta">
          <span>{formatDate(date)}</span>
          <span>·</span>
          <span>{readingTime}</span>
          <span>·</span>
          <span>{category}</span>
          {updated && (
            <>
              <span>·</span>
              <span>{ARTICLE_META.updatedPrefix} {formatDate(updated)}</span>
            </>
          )}
          {source && (
            <>
              <span>·</span>
              <a href={source}>{ARTICLE_META.sourceLabel}</a>
            </>
          )}
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
