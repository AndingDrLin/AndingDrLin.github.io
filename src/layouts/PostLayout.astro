---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import { ARTICLE_META } from '../consts';
import { formatDate } from '../utils/content';

type PostKind = '课程笔记' | '教程' | '博客' | '笔记';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  category: string;
  readingTime: string;
  headings: Heading[];
  path: string;
  kind: PostKind;
  source?: string;
  tags?: string[];
}

const { title, description, date, updated, category, readingTime, headings, path, kind, source, tags } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={updated?.toISOString()}
  tags={tags}
>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" data-reading-progress></div>
  </div>

  <script is:inline>
    (function() {
      const bar = document.querySelector('[data-reading-progress]');
      if (!bar) return;
      let ticking = false;
      function onScroll() {
        if (!ticking) {
          requestAnimationFrame(function() {
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
            bar.style.width = Math.min(pct, 100) + '%';
            ticking = false;
          });
          ticking = true;
        }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>

  <article class="article-layout">
    <TOC headings={headings} />
    <div class="article-main">
      <header class="article-header">
        <p class="eyebrow">{kind}</p>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-meta">
          <span>{formatDate(date)}</span>
          <span>·</span>
          <span>{readingTime}</span>
          <span>·</span>
          <span>{category}</span>
          {updated && (
            <>
              <span>·</span>
              <span>{ARTICLE_META.updatedPrefix} {formatDate(updated)}</span>
            </>
          )}
          {source && (
            <>
              <span>·</span>
              <a href={source}>{ARTICLE_META.sourceLabel}</a>
            </>
          )}
        </div>
        {tags && tags.length > 0 && (
          <div class="article-tags" aria-label="文章标签">
            {tags.map((tag) => <span>{tag}</span>)}
          </div>
        )}
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer class="article-footer-nav" aria-label="文章结束导航">
        <a href="/notes/">浏览全部笔记</a>
        <a href="/notes/quiz/">打开自测</a>
        <a href="#main-content">回到顶部</a>
      </footer>
    </div>
  </article>
</BaseLayout>
