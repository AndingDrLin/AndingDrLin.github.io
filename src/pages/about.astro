---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ABOUT } from '../consts';
---

<BaseLayout title={ABOUT.title} description={ABOUT.description} path="/about/">
  <section class="page-grid">
    <div class="page-intro">
      <p class="eyebrow">{ABOUT.title}</p>
      <h1>{ABOUT.heading}</h1>
    </div>

    <div class="about-copy prose">
      {ABOUT.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>
</BaseLayout>
