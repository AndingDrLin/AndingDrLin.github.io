---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { BLOG_PAGE } from '../../consts';
import { getPublishedCollection } from '../../utils/content';

const posts = await getPublishedCollection('blog');
---

<BaseLayout title={BLOG_PAGE.title} description={BLOG_PAGE.description} path="/blog/">
  <section class="page-grid">
    <div class="page-intro">
      <p class="eyebrow">{BLOG_PAGE.eyebrow}</p>
      <h1>{BLOG_PAGE.heading}</h1>
      <p>{BLOG_PAGE.intro}</p>
    </div>
    <div class="post-list">
      {posts.map((entry) => (
        <PostCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>
