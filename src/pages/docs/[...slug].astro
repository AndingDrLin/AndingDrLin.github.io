---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => (import.meta.env.PROD ? !data.draft : true));

  return docs.map((entry) => {
    const slug = /\/readme$/i.test(entry.id) ? entry.id.replace(/\/readme$/i, '') : entry.id;

    return {
      params: { slug },
      props: { entry, slug }
    };
  });
}

const { entry, slug } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const readingTime = getReadingTime(String(remarkPluginFrontmatter?.readingTime ?? entry.body));
---

<PostLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  updated={entry.data.updated}
  tags={entry.data.tags}
  category={entry.data.category}
  readingTime={readingTime.text}
  headings={headings}
  path={`/docs/${slug}/`}
  kind="文档"
  source={entry.data.source}
>
  <Content />
</PostLayout>
