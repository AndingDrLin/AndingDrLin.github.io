---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TOPIC_CHIPS, HOME } from '../consts';
import { getLatestEntries, getLatestNotes } from '../utils/content';

const [latestPosts, latestNotes] = await Promise.all([
  getLatestEntries('blog', 3),
  getLatestNotes(3)
]);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">{HOME.eyebrow}</p>
    <h1>{SITE_TITLE}</h1>
    <p>{SITE_DESCRIPTION}</p>
    <p>{HOME.intro}</p>
    <ul class="topic-chips" aria-label="主题">
      {TOPIC_CHIPS.map((topic) => (
        <li>{topic}</li>
      ))}
    </ul>
  </section>

  <section class="start-here" aria-labelledby="start-here-title">
    <div class="section-heading">
      <h2 id="start-here-title">{HOME.startTitle}</h2>
    </div>
    <div class="start-grid">
      {HOME.startLinks.map((item) => (
        <a class="start-card" href={item.href}>
          <span>{item.label}</span>
          <p>{item.description}</p>
        </a>
      ))}
    </div>
  </section>

  <div class="home-sections">
    <section class="section-block">
      <div class="section-heading">
        <h2>{HOME.blogSectionTitle}</h2>
        <a class="section-link" href="/blog">{HOME.blogSectionLink}</a>
      </div>
      <div class="post-list">
        {latestPosts.map((entry) => (
          <PostCard entry={entry} />
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <h2>{HOME.notesSectionTitle}</h2>
        <a class="section-link" href="/notes">{HOME.notesSectionLink}</a>
      </div>
      <div class="post-list">
        {latestNotes.map((entry) => (
          <PostCard entry={entry} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
