---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { NOTE_COURSES, NOTE_TUTORIALS } from '../../consts';
import { getReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => (import.meta.env.PROD ? !data.draft : true));

  return notes
    .filter((entry) => !(entry.data.docGroup in NOTE_COURSES) && !(entry.data.docGroup in NOTE_TUTORIALS))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry }
    }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const readingTime = getReadingTime(String(remarkPluginFrontmatter?.readingTime ?? entry.body ?? ''));
---

<PostLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  updated={entry.data.updated}
  category={entry.data.category}
  readingTime={readingTime.text}
  headings={headings}
  path={`/notes/${entry.id}/`}
  kind="笔记"
  source={entry.data.source}
  tags={entry.data.tags}
>
  <Content />
</PostLayout>
