---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NoteDirectoryList from '../../../components/NoteDirectoryList.astro';
import { NOTE_COURSES } from '../../../consts';
import { getPublishedCollection } from '../../../utils/content';
import { getNoteDirectoryListing, isReadmeEntry } from '../../../utils/noteTree';

export async function getStaticPaths() {
  return Object.values(NOTE_COURSES).map((course) => ({
    params: { course: course.slug },
    props: { course }
  }));
}

const { course } = Astro.props;
const allNotes = await getPublishedCollection('notes');
const group = Object.entries(NOTE_COURSES).find(([, value]) => value.slug === course.slug)?.[0];
const entries = allNotes.filter((entry) => entry.data.docGroup === group && !isReadmeEntry(entry));
const readme = allNotes.find((entry) => entry.data.docGroup === group && isReadmeEntry(entry));
const { directories, entries: currentEntries } = getNoteDirectoryListing(entries);
---

<BaseLayout title={course.title} description={course.description} path={`/notes/${course.slug}/`}>
  <section class="page-grid">
    <div class="page-intro">
      <p class="eyebrow">课程笔记</p>
      <h1>{course.title}</h1>
      <p>{readme?.data.description ?? course.description}</p>
    </div>

    <NoteDirectoryList directories={directories} entries={currentEntries} basePath={`/notes/${course.slug}/`} />
  </section>
</BaseLayout>
