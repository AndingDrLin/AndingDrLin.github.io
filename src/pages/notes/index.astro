---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedCollection } from '../../utils/content';

const notes = await getPublishedCollection('notes');
---

<BaseLayout title="笔记" description="关于实验、智能体、研究和技术问题的短笔记。" path="/notes/">
  <section class="page-grid">
    <div class="page-intro">
      <p class="eyebrow">笔记</p>
      <h1>短想法、阶段性结论和实践记录。</h1>
      <p>不是所有内容都需要写成长文。笔记用于保存压缩后的观察、快速实验和还没完全打磨但已经有用的想法。</p>
    </div>
    <div class="post-list">
      {notes.map((entry) => (
        <PostCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>
