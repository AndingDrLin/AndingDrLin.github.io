---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { NOTE_COURSES, NOTES_PAGE } from '../../consts';
import { getPublishedCollection } from '../../utils/content';

const [notes, docs] = await Promise.all([
  getPublishedCollection('notes'),
  getPublishedCollection('docs')
]);
const courses = Object.entries(NOTE_COURSES).map(([group, course]) => ({
  ...course,
  count: docs.filter((entry) => entry.data.docGroup === group && !/\/readme$/i.test(entry.id)).length
}));
---

<BaseLayout title={NOTES_PAGE.title} description={NOTES_PAGE.description} path="/notes/">
  <section class="page-grid">
    <div class="page-intro">
      <p class="eyebrow">{NOTES_PAGE.eyebrow}</p>
      <h1>{NOTES_PAGE.heading}</h1>
      <p>{NOTES_PAGE.intro}</p>
    </div>

    <div class="home-sections">
      <section class="section-block">
        <div class="section-heading">
          <h2>{NOTES_PAGE.courseNotesTitle}</h2>
        </div>
        <div class="course-grid">
          {courses.map((course) => (
            <a class="course-card" href={`/notes/${course.slug}/`}>
              <h3>{course.title}</h3>
              <p>{course.description}</p>
              <span class="course-count">{course.count} 篇笔记</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section-block">
        <div class="section-heading">
          <h2>{NOTES_PAGE.otherNotesTitle}</h2>
        </div>
        <div class="post-list">
          {notes.map((entry) => (
            <PostCard entry={entry} />
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
