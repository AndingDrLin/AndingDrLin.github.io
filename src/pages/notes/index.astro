---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { NOTE_COURSES, NOTE_TUTORIALS, NOTES_PAGE } from '../../consts';
import { getPublishedCollection } from '../../utils/content';
import { isReadmeEntry } from '../../utils/noteTree';
import { subjects } from '../../data/question-banks/subjects';

const allNotes = await getPublishedCollection('notes');

const courses = Object.entries(NOTE_COURSES).map(([group, course]) => ({
  ...course,
  count: allNotes.filter((entry) => entry.data.docGroup === group && !isReadmeEntry(entry)).length
}));

const tutorials = Object.entries(NOTE_TUTORIALS).map(([group, tutorial]) => ({
  ...tutorial,
  count: allNotes.filter((entry) => entry.data.docGroup === group && !isReadmeEntry(entry)).length
}));

const otherNotes = allNotes.filter((entry) => {
  const group = entry.data.docGroup;
  if (group && group in NOTE_COURSES) return false;
  if (group && group in NOTE_TUTORIALS) return false;
  return !isReadmeEntry(entry);
});
---

<BaseLayout title={NOTES_PAGE.title} description={NOTES_PAGE.description} path="/notes/">
  <section class="page-grid">
    <div class="page-intro">
      <p class="eyebrow">{NOTES_PAGE.eyebrow}</p>
      <h1>{NOTES_PAGE.heading}</h1>
      <p>{NOTES_PAGE.intro}</p>
    </div>

    <div class="home-sections">
      <section class="section-block">
        <div class="section-heading">
          <h2>{NOTES_PAGE.courseNotesTitle}</h2>
        </div>
        <div class="course-grid">
          {courses.map((course) => (
            <a class="course-card" href={`/notes/${course.slug}/`}>
              <h3>{course.title}</h3>
              <p>{course.description}</p>
              <span class="course-count">{course.count} 篇笔记</span>
            </a>
          ))}
          <a class="course-card" href="/notes/quiz/">
            <h3>自测练习</h3>
            <p>多学科刷题自测：电磁场、EPMF 等课程的选择题与判断题练习，支持错题本与薄弱点分析。</p>
            <span class="course-count">{subjects.length} 个学科</span>
          </a>
        </div>
      </section>

      <section class="section-block">
        <div class="section-heading">
          <h2>{NOTES_PAGE.tutorialNotesTitle}</h2>
        </div>
        <div class="course-grid">
          {tutorials.map((tutorial) => (
            <a class="course-card" href={`/notes/tutorial/${tutorial.slug}/`}>
              <h3>{tutorial.title}</h3>
              <p>{tutorial.description}</p>
              <span class="course-count">{tutorial.count} 篇笔记</span>
            </a>
          ))}
        </div>
      </section>

      {
        otherNotes.length > 0 && (
          <section class="section-block">
            <div class="section-heading">
              <h2>{NOTES_PAGE.otherNotesTitle}</h2>
            </div>
            <div class="post-list">
              {otherNotes.map((entry) => (
                <PostCard entry={entry} />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </section>
</BaseLayout>
