---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { NOTE_COURSES } from '../../consts';
import { getPublishedCollection } from '../../utils/content';

const [notes, docs] = await Promise.all([
  getPublishedCollection('notes'),
  getPublishedCollection('docs')
]);
const courses = Object.entries(NOTE_COURSES).map(([group, course]) => ({
  ...course,
  count: docs.filter((entry) => entry.data.docGroup === group && !/\/readme$/i.test(entry.id)).length
}));
---

<BaseLayout title="笔记" description="课程笔记、短想法、阶段性结论和实践记录。" path="/notes/">
  <section class="page-grid">
    <div class="page-intro">
      <p class="eyebrow">笔记</p>
      <h1>课程笔记与阶段性记录。</h1>
      <p>这里是笔记入口。选择一门课程查看按章节整理的笔记。</p>
    </div>

    <div class="home-sections">
      <section class="section-block">
        <div class="section-heading">
          <h2>课程笔记</h2>
        </div>
        <div class="course-grid">
          {courses.map((course) => (
            <a class="course-card" href={`/notes/${course.slug}/`}>
              <h3>{course.title}</h3>
              <p>{course.description}</p>
              <span class="course-count">{course.count} 篇笔记</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section-block">
        <div class="section-heading">
          <h2>其他笔记</h2>
        </div>
        <div class="post-list">
          {notes.map((entry) => (
            <PostCard entry={entry} />
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
