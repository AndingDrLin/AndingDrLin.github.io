---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { NOTE_COURSES } from '../../consts';
import { getPublishedCollection } from '../../utils/content';

const [notes, docs] = await Promise.all([
  getPublishedCollection('notes'),
  getPublishedCollection('docs')
]);
const courses = Object.entries(NOTE_COURSES).map(([group, course]) => ({
  ...course,
  entries: docs.filter((entry) => entry.data.docGroup === group && !/\/readme$/i.test(entry.id))
}));
---

<BaseLayout title="笔记" description="课程笔记、短想法、阶段性结论和实践记录。" path="/notes/">
  <section class="page-grid">
    <div class="page-intro">
      <p class="eyebrow">笔记</p>
      <h1>课程笔记与阶段性记录。</h1>
      <p>这里是笔记入口。课程资料会先按课程归档，再进入每一篇按序号整理的复习笔记。</p>
    </div>

    <div class="home-sections">
      {courses.map((course) => (
        <section class="section-block">
          <div class="section-heading">
            <div>
              <h2>{course.title}</h2>
              <p>{course.description}</p>
            </div>
            <a class="section-link" href={`/notes/${course.slug}/`}>进入课程</a>
          </div>
          <div class="post-list">
            {course.entries.map((entry) => (
              <PostCard entry={entry} />
            ))}
          </div>
        </section>
      ))}

      <section class="section-block">
        <div class="section-heading">
          <h2>其他笔记</h2>
        </div>
        <div class="post-list">
          {notes.map((entry) => (
            <PostCard entry={entry} />
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
