---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPublishedEntries } from '../../utils/content';
import { collectTags, slugifyTag } from '../../utils/tags';

export async function getStaticPaths() {
  const entries = await getAllPublishedEntries();
  const tags = collectTags(entries);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { slug: tag.slug, label: tag.label }
  }));
}

const { slug, label } = Astro.props;
const entries = await getAllPublishedEntries();
const matching = entries.filter(({ entry }) => entry.data.tags.some((tag: string) => slugifyTag(tag) === slug));
---

<BaseLayout title={`标签：${label}`} description={`标记为 ${label} 的内容。`} path={`/tags/${slug}/`}>
  <section class="page-grid">
    <div class="page-intro">
      <p class="eyebrow">标签归档</p>
      <h1>#{label}</h1>
      <p>共有 {matching.length} 篇相关内容，来自博客、笔记或文档。</p>
    </div>

    <div class="post-list">
      {matching.map(({ entry }) => (
        <PostCard entry={entry} showKind />
      ))}
    </div>
  </section>
</BaseLayout>
