---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPublishedEntries } from '../../utils/content';
import { collectTags } from '../../utils/tags';

const entries = await getAllPublishedEntries();
const tags = collectTags(entries);
---

<BaseLayout title="标签" description="按标签浏览博客、笔记和文档。" path="/tags/">
  <section class="page-grid tags-grid">
    <div class="page-intro">
      <p class="eyebrow">标签</p>
      <h1>按主题浏览，而不是按内容形式浏览。</h1>
      <p>标签会同时覆盖博客、笔记和文档，适合沿着一个主题追踪相关内容。</p>
    </div>

    {tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map((tag) => (
          <li>
            <a href={`/tags/${tag.slug}/`}>
              <span>#{tag.label}</span>
              <span class="muted">{tag.count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">还没有标签。</p>
    )}
  </section>
</BaseLayout>
